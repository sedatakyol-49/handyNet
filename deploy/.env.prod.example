# Copy to deploy/.env.prod (git-ignored), chmod 600, and fill in. Never commit real values.
# Generate the secrets with: ./scripts/generate-secrets.sh

# --- Domain / TLS -----------------------------------------------------------------------------------------------
# Public host name; its DNS A/AAAA record must point at this server before the first start (Let's Encrypt).
DOMAIN=seha.example.de
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.de
# Optional extra hosts allowed in the CSP img-src (e.g. an S3 bucket serving product images). Usually empty.
CSP_IMG_EXTRA=

# --- Images (built and pushed by CI to GHCR) --------------------------------------------------------------------
# Images are ${IMAGE_PREFIX}-api and ${IMAGE_PREFIX}-web. Lower-case owner.
IMAGE_PREFIX=ghcr.io/OWNER/handynet
# Tag = commit SHA from CI (or "latest"). `./deploy.sh <sha>` overrides it.
IMAGE_TAG=latest

# --- Database ---------------------------------------------------------------------------------------------------
# Owner login: used by the migrator and the backup job only. Hex string, no special characters.
POSTGRES_PASSWORD=
# Restricted login of the API (NOBYPASSRLS; row level security applies). The role is created on the FIRST start of an
# empty volume; changing this later also needs ALTER ROLE handynet_app PASSWORD '...' in psql.
HANDYNET_APP_PASSWORD=

# --- API secrets ------------------------------------------------------------------------------------------------
# JWT signing key, >= 32 bytes of randomness. Changing it signs every user out.
JWT_SIGNING_KEY=
# Platform admin created/promoted at API start (idempotent). After the first login set a personal password in the app
# and clear BOOTSTRAP_ADMIN_PASSWORD here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.de
BOOTSTRAP_ADMIN_PASSWORD=

# --- Email (real SMTP relay, required; there is no Mailpit in production) ---------------------------------------------
# Sender address; its domain needs SPF/DKIM/DMARC at your mail provider.
MAIL_FROM=no-reply@seha.example.de
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# None | Auto | StartTls | StartTlsWhenAvailable | SslOnConnect   (587 -> StartTls, 465 -> SslOnConnect)
SMTP_SECURITY=StartTls

# --- Product image storage (ADR-0011) -----------------------------------------------------------------------------
# Local = Docker volume "files" (included in the backups). S3 = S3-compatible object storage (fill the S3_* values).
FILESTORAGE_PROVIDER=Local
S3_SERVICE_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Backups (daily, container "backup") ----------------------------------------------------------------------------
# Local copies live in the "backups" volume; older than this many days are pruned.
BACKUP_KEEP_DAYS=14
# Time of day in UTC (HH:MM).
BACKUP_TIME_UTC=02:15
# Optional off-host upload to S3-compatible storage (Hetzner Object Storage: https://<location>.your-objectstorage.com).
# Leave BACKUP_S3_BUCKET empty to disable. Use a dedicated bucket and key, separate from product images.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=handynet
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
