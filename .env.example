# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
POSTGRES_PASSWORD=change-me-owner-password
HANDYNET_APP_PASSWORD=change-me-app-password
JWT_SIGNING_KEY=change-me-to-a-random-string-of-at-least-32-bytes
BOOTSTRAP_ADMIN_EMAIL=admin@example.de
BOOTSTRAP_ADMIN_PASSWORD=change-me-Admin-123
PUBLIC_ORIGIN=http://localhost:8080
# Email. Leave SMTP_HOST unset to use the bundled Mailpit (local only).
MAIL_FROM=no-reply@example.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=Auto
