{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HandyNet": "",
    "HandyNetMigrations": ""
  },
  "Jwt": {
    "Issuer": "handynet",
    "Audience": "handynet",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "Origins": []
  },
  "RateLimits": {
    "AuthPerMinute": 20
  },
  "Ordering": {
    "InspectionWindowHours": 48
  },
  "Shipping": {
    "EnabledCarriers": [ "Manual" ],
    "TrackingSyncMinutes": 15
  },
  "Payments": {
    "EnabledProviders": [],
    "CommissionBasisPoints": 300,
    "ApiBaseUrl": "http://localhost:5170",
    "WebBaseUrl": "http://localhost:4200"
  },
  "Notifications": {
    "PublicBaseUrl": "http://localhost:4200"
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  }
}
